{
  "name": "web-did-resolver",
  "version": "2.0.32",
  "description": "Resolve DID documents from an https domain",
  "type": "module",
  "source": "src/resolver.ts",
  "main": "./lib/resolver.cjs",
  "module": "./lib/resolver.module.js",
  "types": "./lib/resolver.d.ts",
  "files": [
    "lib",
    "src",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./lib/resolver.d.ts",
      "require": "./lib/resolver.cjs",
      "import": "./lib/resolver.module.js"
    }
  },
  "author": "Mike Xu",
  "contributors": [
    "Mircea Nistor"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git@github.com:decentralized-identity/web-did-resolver.git"
  },
  "dependencies": {
    "cross-fetch": "^4.1.0",
    "did-resolver": "^6.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "build": "tsup && tsc --emitDeclarationOnly",
    "format": "biome format --write src",
    "lint": "biome lint src",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm test:ci && pnpm format && pnpm lint && pnpm typecheck",
    "release": "semantic-release --debug"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "semantic-release": "25.0.9",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "@vitest/coverage-v8": "5.0.1",
    "vitest": "5.0.1"
  },
  "packageManager": "pnpm@12.5.1"
}
