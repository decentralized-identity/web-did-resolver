{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "lib": [
      "es2024",
      "dom"
    ],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "lib.esm",
    "rootDir": "src",
    "strict": true,
    "moduleResolution": "nodenext",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "exclude": [
    "**/__tests__/*",
    "node_modules",
    "lib",
    "lib.commonjs",
    "lib.esm"
  ],
  "include": [
    "src/**/*.ts"
  ]
}
